# BoxBox — Environment Variables
# Copia questo file in .env e compila i valori

# MotoGP Fantasy League ID (numerico, dalla URL della tua lega su fantasy.motogp.com)
LEAGUE_ID=123456

# Cookie di sessione (alternativa: generare via renew-dat.mjs)
# Ottenere da: F12 su fantasy.motogp.com → Network → Cookie header
COOKIE_FULL=

# Per auto-renew cookie via Playwright (opzionale)
EMAIL=
PASSWORD=

# URL Chrome DevTools Protocol (opzionale, default: http://localhost:9222)
# CDP_URL=http://localhost:9222

# Nomi dei giocatori della tua lega da monitorare per i cambi roster
# (feature "Cambi rivali" — fetch-teams.mjs / team-diff.mjs / notify-discord.sh),
# separati da virgola, esattamente come compaiono in all-teams.json
RIVALS=Rivale1,Rivale2,Rivale3

# Webhook Discord per le notifiche (DAT scaduto, leaderboard vuota, cambi rivali)
DISCORD_WEBHOOK_URL=

# Chiave API NVIDIA NIM (opzionale — solo per la classificazione news via LLM,
# analyze-news.mjs / nvidia-model-health.py). Senza, quella feature si disattiva
# da sola (degradazione soft: la card "Dalle notizie" semplicemente non compare).
NVIDIA_API_KEY=
